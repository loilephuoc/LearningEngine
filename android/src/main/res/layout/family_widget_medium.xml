<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_family_widget_card"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top Header Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:id="@+id/widget_header_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/widget_solar_weekday"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Thứ Ba"
                    android:textColor="#1976D2"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" · "
                    android:textColor="#9E9E9E"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/widget_solar_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="25/08/2026"
                    android:textColor="#1C1B1F"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" · "
                    android:textColor="#9E9E9E"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/widget_lunar_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="13/7 Âm lịch"
                    android:textColor="#D84315"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_btn_quick_add"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+"
                android:textColor="#1976D2"
                android:textSize="16sp"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp" />

            <TextView
                android:id="@+id/widget_btn_view_calendar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/family_widget_view_calendar"
                android:textColor="#1976D2"
                android:textSize="12sp"
                android:textStyle="bold"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp" />
        </LinearLayout>

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E8EEF5"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp" />

        <!-- Up to 3 Item Rows -->
        <LinearLayout
            android:id="@+id/widget_items_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <!-- Item 1 -->
            <LinearLayout
                android:id="@+id/widget_item_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_family_widget_item"
                android:padding="5dp"
                android:layout_marginBottom="4dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/widget_item_1_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎂"
                    android:textSize="13sp"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/widget_item_1_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Sinh nhật Ba"
                    android:textColor="#1C1B1F"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/widget_item_1_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hôm nay"
                    android:textColor="#1976D2"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:maxLines="1" />
            </LinearLayout>

            <!-- Item 2 -->
            <LinearLayout
                android:id="@+id/widget_item_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_family_widget_item"
                android:padding="5dp"
                android:layout_marginBottom="4dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/widget_item_2_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📋"
                    android:textSize="13sp"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/widget_item_2_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Công việc A"
                    android:textColor="#1C1B1F"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/widget_item_2_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="17:00"
                    android:textColor="#1976D2"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:maxLines="1" />
            </LinearLayout>

            <!-- Item 3 -->
            <LinearLayout
                android:id="@+id/widget_item_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_family_widget_item"
                android:padding="5dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/widget_item_3_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🕯"
                    android:textSize="13sp"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/widget_item_3_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Giỗ Ông Ngoại"
                    android:textColor="#1C1B1F"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/widget_item_3_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="05/09"
                    android:textColor="#D84315"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:maxLines="1" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_empty_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/family_widget_empty_upcoming"
                android:textColor="#757575"
                android:textSize="12sp"
                android:gravity="center"
                android:visibility="gone" />
        </LinearLayout>

    </LinearLayout>
</FrameLayout>
