<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:paddingStart="6dp"
    android:paddingEnd="6dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <ImageView
        android:id="@+id/widget_card_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY" />

    <LinearLayout
        android:id="@+id/widget_card_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <!-- ZONE 1: PRIMARY VOCABULARY GROUP (Top-aligned) -->
        <FrameLayout
            android:id="@+id/widget_primary_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/widget_primary_zone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="top">

                <ImageView
                    android:id="@+id/widget_image"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter" />

                <LinearLayout
                    android:id="@+id/widget_text_column"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="top"
                    android:paddingEnd="28dp">

                    <TextView
                        android:id="@+id/widget_headword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="English word"
                        android:textColor="#111827"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:includeFontPadding="false"
                        android:maxLines="2" />

                    <LinearLayout
                        android:id="@+id/widget_ipa_pos_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/widget_ipa"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="/ipa/"
                            android:textColor="#6B7280"
                            android:textSize="13sp"
                            android:singleLine="true"
                            android:maxLines="1"
                            android:includeFontPadding="false" />

                        <TextView
                            android:id="@+id/widget_pos"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_widget_pos_badge"
                            android:paddingStart="7dp"
                            android:paddingEnd="7dp"
                            android:paddingTop="2dp"
                            android:paddingBottom="2dp"
                            android:text="noun"
                            android:textColor="#374151"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:singleLine="true"
                            android:maxLines="1"
                            android:ellipsize="none"
                            android:includeFontPadding="false" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/widget_meaning"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Nghĩa tiếng Việt"
                        android:textColor="#1F2937"
                        android:textSize="15sp"
                        android:includeFontPadding="false"
                        android:maxLines="3" />
                </LinearLayout>
            </LinearLayout>

            <!-- 3-ACTION QUICK OVERLAY STRIP (Top-Right of Primary Zone: Audio / Star / Full Review) -->
            <LinearLayout
                android:id="@+id/widget_actions_strip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <!-- TOP ACTION: AUTO AUDIO TOGGLE -->
                <ImageView
                    android:id="@+id/widget_action_audio_toggle"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:padding="3dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_widget_audio_off"
                    android:contentDescription="Toggle auto audio" />

                <!-- MIDDLE ACTION: MARK DIFFICULT (STAR) -->
                <ImageView
                    android:id="@+id/widget_action_star"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginTop="2dp"
                    android:padding="3dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_widget_star_outline"
                    android:contentDescription="Mark difficult" />

                <!-- BOTTOM ACTION: FULL REVIEW (EYE) -->
                <ImageView
                    android:id="@+id/widget_action_full_review"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginTop="2dp"
                    android:padding="3dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_widget_eye"
                    android:contentDescription="Open full review" />
            </LinearLayout>
        </FrameLayout>

        <!-- ZONE 2: FULL-WIDTH EXAMPLE AREA WITH OVERLAY NAVIGATION (‹ and ›) -->
        <FrameLayout
            android:id="@+id/widget_example_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp">

            <!-- Example Text Group with safe horizontal inset -->
            <LinearLayout
                android:id="@+id/widget_example_zone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/widget_example_english"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#374151"
                    android:textSize="12sp"
                    android:textStyle="normal"
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/widget_example_vietnamese"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#6B7280"
                    android:textSize="11sp"
                    android:textStyle="italic"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <!-- PREVIOUS BUTTON (‹) (Anchored Left) -->
            <ImageView
                android:id="@+id/widget_action_prev"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center_vertical|start"
                android:background="@drawable/bg_widget_nav_circle"
                android:padding="5dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_nav_prev"
                android:contentDescription="Previous vocabulary" />

            <!-- NEXT BUTTON (›) (Anchored Right) -->
            <ImageView
                android:id="@+id/widget_action_next"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center_vertical|end"
                android:background="@drawable/bg_widget_nav_circle"
                android:padding="5dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_nav_next"
                android:contentDescription="Next vocabulary" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
