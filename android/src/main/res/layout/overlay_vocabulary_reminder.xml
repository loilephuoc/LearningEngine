<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlay_card_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_overlay_reminder_card"
    android:elevation="12dp"
    android:clipToOutline="true"
    android:padding="8dp">

    <LinearLayout
        android:id="@+id/overlay_content_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="165dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/overlay_thumbnail"
            android:layout_width="145dp"
            android:layout_height="165dp"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            android:visibility="gone"
            android:contentDescription="Vocabulary image" />

        <LinearLayout
            android:id="@+id/overlay_text_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="16dp"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/overlay_primary_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:maxLines="2"
                android:ellipsize="end" />

            <LinearLayout
                android:id="@+id/overlay_metadata_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/overlay_ipa"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="#A0A6B2"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/overlay_pos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_overlay_pos_badge"
                    android:paddingHorizontal="5dp"
                    android:paddingVertical="1dp"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#B0B5C0"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/overlay_meaning"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="20sp"
                android:textColor="#E2E4E9"
                android:maxLines="2"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/overlay_close_button"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_gravity="top|end"
        android:layout_margin="2dp"
        android:padding="3dp"
        android:src="@drawable/ic_overlay_close"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="Close reminder overlay" />
</FrameLayout>
