<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/quick_review_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:contentDescription="@string/quick_review_widget_content_description"
    android:background="@drawable/bg_home_widget_card"
    android:padding="20dp">

    <TextView android:id="@+id/quick_review_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/quick_review_widget_title" android:textColor="#166534" android:textStyle="bold" android:textSize="14sp" />
    <TextView android:id="@+id/quick_review_package" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#6B7280" android:textSize="13sp" android:maxLines="1" />
    <Space android:layout_width="1dp" android:layout_height="12dp" />
    <TextView android:id="@+id/quick_review_word" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center" android:contentDescription="@string/quick_review_widget_word_content_description" android:textColor="#111827" android:textStyle="bold" android:textSize="34sp" android:maxLines="2" />
    <TextView android:id="@+id/quick_review_pronunciation" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center" android:textColor="#4B5563" android:textSize="16sp" android:maxLines="1" />
    <TextView android:id="@+id/quick_review_meaning" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:gravity="center" android:contentDescription="@string/quick_review_widget_meaning_content_description" android:text="@string/quick_review_widget_reveal_hint"
        android:textColor="#1F2937" android:textSize="23sp" android:maxLines="4" />
    <TextView android:id="@+id/quick_review_example" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center" android:textColor="#4B5563" android:textSize="15sp" android:maxLines="2" android:visibility="gone" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:orientation="horizontal" android:gravity="center">
        <Button android:id="@+id/quick_review_reveal" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="@string/quick_review_widget_reveal" android:contentDescription="@string/quick_review_widget_reveal" />
        <Button android:id="@+id/quick_review_again" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="@string/quick_review_widget_again" android:visibility="gone" />
        <Button android:id="@+id/quick_review_hard" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="@string/quick_review_widget_hard" android:visibility="gone" />
        <Button android:id="@+id/quick_review_good" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="@string/quick_review_widget_good" android:visibility="gone" />
        <Button android:id="@+id/quick_review_easy" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="@string/quick_review_widget_easy" android:visibility="gone" />
        <Button android:id="@+id/quick_review_next" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="@string/quick_review_widget_next" android:contentDescription="@string/quick_review_widget_next_content_description" />
    </LinearLayout>
</LinearLayout>
