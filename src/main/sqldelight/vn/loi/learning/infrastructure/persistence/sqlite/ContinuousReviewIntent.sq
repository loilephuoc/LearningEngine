CREATE TABLE continuous_review_intent (
    learnerId TEXT NOT NULL,
    installedPackageId TEXT NOT NULL,
    topicId TEXT,
    enabled INTEGER NOT NULL DEFAULT 0,
    updatedAtEpochMillis INTEGER NOT NULL,
    lastNoWorkPredecessorId TEXT,
    PRIMARY KEY (learnerId, installedPackageId)
);

findByLearner:
SELECT * FROM continuous_review_intent WHERE learnerId = ? LIMIT 1;

findByLearnerAndPackage:
SELECT * FROM continuous_review_intent WHERE learnerId = ? AND installedPackageId = ?;

findAll:
SELECT * FROM continuous_review_intent;

insertOrReplace:
INSERT OR REPLACE INTO continuous_review_intent (
    learnerId, installedPackageId, topicId, enabled, updatedAtEpochMillis, lastNoWorkPredecessorId
) VALUES (
    ?, ?, ?, ?, ?, ?
);

delete:
DELETE FROM continuous_review_intent WHERE learnerId = ? AND installedPackageId = ?;

deleteAll:
DELETE FROM continuous_review_intent;
